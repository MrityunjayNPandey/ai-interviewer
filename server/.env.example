# MongoDB connection string (Atlas free tier in production).
MONGODB_URI=mongodb://127.0.0.1:27017/ai-interviewer

# Groq API key: https://console.groq.com/keys
GROQ_API_KEY=

# Model used for every AI call (until per-interview model choice lands).
AI_MODEL=openai/gpt-oss-120b

# Local dev port (Vite proxies /api to it).
PORT=8080
