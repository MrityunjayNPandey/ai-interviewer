# MongoDB connection string (Atlas free tier in production).
MONGODB_URI=mongodb://127.0.0.1:27017/ai-interviewer

# AI providers. Each model in src/ai/models.ts is offered only when its provider's key is set.
# Groq is the default and is needed for parsing unless PARSE_MODEL points elsewhere.
GROQ_API_KEY=          # https://console.groq.com/keys
MISTRAL_API_KEY=       # https://console.mistral.ai/api-keys (free tier may train on inputs)
GEMINI_API_KEY=        # https://aistudio.google.com/apikey (free tier may train on inputs; not for EEA/UK/CH users)
OPENROUTER_API_KEY=    # https://openrouter.ai/keys (free models: small daily cap shared by all users)

# Optional: model id used to parse resumes and job descriptions (default groq:openai/gpt-oss-120b).
# PARSE_MODEL=

# Local dev port (Vite proxies /api to it).
PORT=8080
